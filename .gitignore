# Runtime project state + generated worlds
projects/
cells/

# Scratch (local-only design notes / prototypes / archives, never committed)
docs-temp/
_proposals/
_archive/

# Shared map cache (terrain / OSM / land cover) - huge, regenerated on demand, never committed
cache/

# Backup / pre-merge binaries (only the live arnis.exe is committed)
arnis-*.exe
*.exe.bak*
!arnis.exe

# Python
__pycache__/
*.pyc
.pytest_cache/

# One-click launcher: per-machine virtualenv + the platform-specific arnis binary it
# downloads/builds (only the Windows arnis.exe is committed; mac/linux fetch their own).
.venv/
/arnis
/arnis-linux
/arnis-mac-intel
/arnis-mac-arm64
/arnis-*.tar.gz

# Note: arnis.exe (the custom Arnis fork binary) is intentionally committed to this repo.

# Local benchmark scratch (not shipped)
experimental/bench.py
experimental/bench_matrix.py
experimental/sweep.sh
experimental/bench*.log
experimental/bench*.json
experimental/bench*.out
experimental/sweep*
experimental/_bench/
experimental/_cells/
experimental/_work/

# tree-packs/ ships WITH Meld now (the region-aware schematic tree pack, ~7.4 MB) so it works out of
# the box. The RAW source art stays out of git (root meld-fork-trees/, gitignored). The Arnis fork
# stays pack-agnostic - it just loads whatever --tree-pack dir Meld hands it.

# Pack-BUILD tooling - local-only, never shipped. The baked tree-packs/ ship; the scripts that build
# them do not (they hardcode local scratch paths and need the raw art, so they cannot run for a cloner).
# Kept on disk for local re-bakes; just untracked from the public repo.
tools/*
# ...except the flag-contract smoke test, which is a portable guardrail worth tracking.
!tools/flag_smoke.py

# Local run scratch (benchmark/debug output, never committed)
run*.log
run*_result.json

# The old cave engine's cave.json format (obsolete; the live pack ships in cave-pack/).
cave-packs/
server-run.*

# Seam-test renders (multi-GB region files, regenerated on demand)
tools/seam_test/_work/
tools/height_test/_work/

# Meld runtime state (per-machine, never committed): the single-instance lock, the session
# file holding the live port + token, rotated logs, and the writable twin of assets/.
*.lock
session.json
# Status bar position, opacity, console choice and hidden/shown state.
statusbar.json
logs/
user-assets/
data/

# PyInstaller output (packaging/build.py) — ~150 MB per build, rebuilt on demand.
build/
dist/

# Private browser profiles the app + preview windows run against (created at runtime, ~40 MB of
# Edge state each). Without a profile of its own, --app= hands the URL to the user's own browser.
ui-profiles/
preview-profile/
assets/build-info.json

# Runtime download location for the generator. paths.bin_dir() is data_dir()/bin, and from a
# source checkout data_dir() IS the repo root - so a self-updated arnis lands here. 45 MB of
# binary that must never reach a commit; the updater writes it, git ignores it.
/bin/
# The default .pbf download folder. data_dir() is the repo root from a source checkout, so the
# eager-created drop folder lands here - same trap as /bin/ above, same fix.
/pbf/
